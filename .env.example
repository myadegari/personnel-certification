# ============================================================
# personnel-certification environment template
# Copy to `.env.local` (app) and/or `.env` (docker compose) and
# fill in real values. NEVER commit real secrets.
#   cp .env.example .env.local
#   cp .env.example .env
# ============================================================

# --- Database (used by the app AND docker compose) ----------
# If your Mongo instance requires auth, embed credentials in the URI.
MONGODB_URL=mongodb://127.0.0.1:27017/certification

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-strong-mongo-password

# --- NextAuth -------------------------------------------------
# Public URL of the app (also used in emails)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-random-secret

# --- Object storage: Alarik (S3-compatible) ------------------
# App-side client settings.
# STORAGE_REGION must EXACTLY match ALARIK_REGION on the server,
# otherwise requests are rejected with a region-mismatch error.
STORAGE_ENDPOINT=http://localhost:8080
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=change-me-access-key
STORAGE_SECRET_KEY=change-me-secret-key
# Public base URL used to rewrite presigned URLs for browsers
# (e.g. the nginx /storage/ proxy or a direct Alarik host)
STORAGE_PUBLIC_URL=http://localhost:8080

# Alarik server settings (docker compose)
ALARIK_API_BASE_URL=http://alarik:8080
ALARIK_CONSOLE_BASE_URL=http://localhost:3001
ALARIK_PUBLIC_API_URL=http://localhost:8080
ALARIK_REGION=us-east-1
ALARIK_ADMIN_USERNAME=alarik-admin
ALARIK_ADMIN_PASSWORD=change-me-strong-console-password
# JWT signing key for the Alarik console - generate with: openssl rand -base64 48
ALARIK_JWT=change-me-random-jwt-key

# --- SMTP (Gmail) --------------------------------------------
GMAIL_EMAIL=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Certificate microservice --------------------------------
# Server-side base URL (route handlers call the FastAPI service)
MICROSERVICE_URL=http://localhost:8000
# Browser-side base URL used by CertificateStatus.jsx (REST + WebSocket).
# Behind nginx use the /ms/ proxy path; for direct dev access keep :8000.
NEXT_PUBLIC_MICROSERVICE_URL=http://localhost:8000
# Absolute public URL of this app (encoded into certificate QR codes).
# Defaults to NEXTAUTH_URL when unset.
PUBLIC_SITE_URL=http://localhost:3000=http://localhost:8000
